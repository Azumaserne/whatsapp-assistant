# ==============================================================================
# WhatsApp AI Assistant — 配置文件示例
# 复制本文件为 .env 并填入你自己的 API Key 后启动
# ⚠️ 须自备 API；基于非官方 whatsapp-web.js，封号风险自负，强烈建议使用小号！
# ==============================================================================

# 1. 大模型 API 配置（支持任意 OpenAI 兼容接口）
LLM_API_KEY=your-api-key-here
LLM_BASE_URL=https://api.openai.com/v1
LLM_MODEL=gpt-4o-mini

# 常见 OpenAI 兼容服务商配置参考（取消对应注释或自行替换上方 3 项）：
# --- DeepSeek ---
# LLM_BASE_URL=https://api.deepseek.com
# LLM_MODEL=deepseek-chat
# （也向后兼容旧版 DEEPSEEK_API_KEY=...）
#
# --- OpenRouter ---
# LLM_BASE_URL=https://openrouter.ai/api/v1
# LLM_MODEL=openai/gpt-4o-mini
#
# --- Moonshot / Kimi ---
# LLM_BASE_URL=https://api.moonshot.cn/v1
# LLM_MODEL=moonshot-v1-8k
#
# --- Google Gemini (OpenAI 兼容端点) ---
# LLM_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/
# LLM_MODEL=gemini-2.5-flash
#
# --- 智谱 GLM ---
# LLM_BASE_URL=https://open.bigmodel.cn/api/paas/v4
# LLM_MODEL=glm-4-flash
#
# --- 本地 Ollama ---
# LLM_BASE_URL=http://localhost:11434/v1
# LLM_MODEL=qwen2.5:7b

# 模型生成参数
LLM_TEMPERATURE=0.7
LLM_MAX_TOKENS=1500
LLM_TIMEOUT_MS=60000

# 2. 聊天记录转发与导出分析配置
# true：收到转发消息后，防抖等待 FORWARD_DEBOUNCE_MS 毫秒自动汇总分析（若期间发来提问则立即合并分析）
# false：仅暂存转发消息，等待用户发送问题或 /analyze 指令后再统一分析
FORWARD_AUTO_ANALYZE=true
# 转发批量聚合防抖时间（毫秒），默认 6 秒，适配 WhatsApp 多选转发连发事件
FORWARD_DEBOUNCE_MS=6000
# 导出聊天记录（.txt / .zip）最大保留字符数（超长时自动保留最新尾部对话）
MAX_CHAT_EXPORT_CHARS=60000

# 3. 对话记忆与权限控制
# 每个联系人最多保留的上下文消息条数（不包含 system prompt）
MAX_HISTORY=24
# 允许使用助手的手机号白名单（逗号或分号分隔，留空则响应所有私聊联系人）
# 示例：ALLOWED_NUMBERS=8613800138000,14155550199
ALLOWED_NUMBERS=
# 是否允许在“给自己发消息（Message Yourself）”窗口使用助手（true/false）
ENABLE_SELF_CHAT=false
# 自聊模式防死循环回复前缀（建议保留）
SELF_CHAT_REPLY_PREFIX=🤖 

# 4. 防风控与浏览器设置
# 模拟真人回复随机延迟范围（毫秒）
REPLY_DELAY_MIN_MS=1200
REPLY_DELAY_MAX_MS=3000
# 如需使用本机已安装的 Chrome / Edge，可填写可执行文件绝对路径（留空则使用 Puppeteer 缓存）
CHROME_PATH=
